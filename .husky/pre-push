# --- Secret gate, last chance before objects leave the machine ---------------
#
# Scans exactly the commits `git push` is about to send (everything not yet on
# any remote). This is what catches a secret that slipped past pre-commit, or
# that was committed with --no-verify.
#
# On a private repo GitHub's push protection is unavailable (it needs a public
# repo or a paid SKU), so this hook is the closest thing to a server-side gate:
# after this point the credential is on the remote and ROTATION is mandatory.
if ! git remote | grep -q .; then
  echo "pre-push: no remote configured, nothing to push — skipping secret scan."
  exit 0
fi

# `HEAD` must be explicit. `git log --not --remotes` without a positive
# revision selects NOTHING, which makes the scan pass silently — a gate that
# always says "clean" is worse than no gate at all. Verified against a commit
# containing a fake token: both scanners must exit non-zero.
# `--diff-merges=first-parent` is not cosmetic. gitleaks enumerates only
# non-merge commits (measured: a 4-commit range containing 1 merge scanned 3),
# so anything introduced BY a merge itself — a conflict resolution, a stray
# line pasted while resolving — is invisible to it. Reproduced: a merge whose
# resolved content held a token was reported "no leaks found" without this
# flag, and failed with exit 1 once it was added.
DR="HEAD --not --remotes --diff-merges=first-parent"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --source . --log-opts="$DR" --redact --config .gitleaks.toml
else
  echo "gitleaks not on PATH — falling back to scripts/secret-scan.js (fewer rules)." >&2
  outgoing=$(git log -p $DR -U0 --no-color) || exit 1
  printf '%s\n' "$outgoing" | node scripts/secret-scan.js --patch
fi
