# Runtime data for the compose stack: bind-mounted into the subconverter
# container, so it holds machine-local config/rules/logs. Nothing under it is
# committed. The directories are created by docker/ex/start.sh, so a fresh
# clone works without them.
docker/vol/subconverter/

# WorkBuddy internal data
.workbuddy

# husky generated internals (rebuilt by `prepare` on install)
.husky/_/

# scratch temp files
_tmp_*
