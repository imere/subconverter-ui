# Environment passed to the official tindy2013/subconverter container.
# See https://github.com/tindy2013/subconverter for all options.

# Timezone for logs and scheduled tasks.
TZ=Asia/Shanghai

# API access mode: "http" (default) or "https".
API_MODE=http

# Access token for protected endpoints (/readconf, /updateconf, /flushcache).
# Leave empty for local/dev. Set a strong value before exposing the stack.
SUBCONVERTER_TOKEN=

# Optional: run the container process as a specific uid/gid (if the image honors it).
# PUID=1000
# PGID=1000
